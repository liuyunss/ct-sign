# ============================================================
# CT-Sign 本地调试环境变量模板
# ============================================================
# 用法：cp .env.example .env 后填真实值。仓库根 .env 会被 config.py 自动加载，
# 且已被 .gitignore 忽略（可 git clone 后本地自由调试）。
#
# 线上（青龙）不需要这个文件：直接在「环境变量」面板填同名变量即可。
#
# 格式：KEY=VALUE 每行一个；值里含 = 或空格时请整体加引号。
# 多账号：用 & 或换行分隔。
# ============================================================

# ---------- WorkBuddy（Buddy 加油站）----------
# token 就是客户端登录态 refreshToken（约 700 字符 JWT）。三个变量位任选其一，
# 优先级：CT_WORKBUDDY_COOKIE > CT_WORKBUDDY_AUTH > CT_WORKBUDDY_TOKEN。
# ⚠️ 客户端 v5.7.6+ 把登录态改成信封加密，本机读不出明文，必须手工填以下任一变量。
CT_WORKBUDDY_COOKIE=
CT_WORKBUDDY_AUTH=
CT_WORKBUDDY_TOKEN=
# 可选：签到端点探测开关（url 留空时自动试候选）。留空=按 config 的 auto_probe；
# 置 0=只请求已配置的 url；置 1=强制探测。
# CT_WORKBUDDY_DISCOVER=
# 可选：打印签到请求响应片段，便于定位判定关键词
# CT_WORKBUDDY_DEBUG=

# ---------- 其它平台（示例，按实际需要启用）----------
# CT_PCBETA_AUTH=            # 远景论坛，一体化格式 `cookie||账号||密码`（测试值不入库）
# CT_FULIBA_COOKIE=
# CT_GOPOJIE_COOKIE=
# CT_KXDAO_COOKIE=
# CT_YOUJIAOKU_COOKIE=
# CT_PINGGU_COOKIE=
# CT_3GBIZHI_COOKIE=
# CT_55188_COOKIE=
# CT_HYPERDOWN_AUTH=

# ---------- 通用 ----------
# CT_PROXY=http://127.0.0.1:7890        # 代理（可选）
# CT_RANDOM_DELAY=300                   # 每个账号签到前随机休眠上限（秒）
# CT_RANDOM_DELAY_MIN=60                # 随机休眠下限（秒）
